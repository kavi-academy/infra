aws_region     = "us-east-1"
project_name   = "kavi-devops"
environment    = "staging"
aws_account_id = "250326384271"

# VPC Config
vpc_cidr             = "10.20.0.0/16"
public_subnet_cidrs  = ["10.20.1.0/24", "10.20.2.0/24"]
private_subnet_cidrs = ["10.20.11.0/24", "10.20.2.0/24"]

# EC2 & App Config
instance_type  = "t3.micro"
enable_bastion = false
image_tag      = "latest"

# Database Config (Disabled by default in staging to conserve free tier hours)
enable_rds        = false
db_instance_class = "db.t3.micro"
allocated_storage = 20
